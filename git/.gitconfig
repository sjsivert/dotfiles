[user]
	email = sindrejohan1@gmail.com
	name = Sindre J. I. Sivertsen
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[diff]
	tool = vimdiff
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[difftool]
	prompt = false
	bc3 = trustExitCode
[pull]
	rebase = true
	autoSquash = true
	autoStash = true
	updateRefs = true
[filter "gitignore"]
	clean = "sed '/#gitignore$/d'"
	smudge = cat
[init]
	defaultBranch = main
[rebase]
	autoStash = true
	updateRefs = true
[push]
	autoSetupRemote = true

# clearly makes git better

[column]
        ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true

# why the hell not?
[help]
        autocorrect = prompt
[commit]
        verbose = true
[rerere]
	enabled = true
        autoupdate = true
[core]
        excludesfile = ~/.gitignore

[url "git@github.com:"]
	insteadOf = https://github.com/
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential

[user]
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIxegu6Qmmz2ieyzDVkql/EOq1YIJ6b8nj5TOCe0kWAJ

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  gpgsign = true

