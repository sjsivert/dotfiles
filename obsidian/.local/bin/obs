#!/usr/bin/env bash
# Open a markdown file in Obsidian. The vault is the nearest parent that has
# an .obsidian folder.
# Usage: obs <file>
set -euo pipefail
file=$(cd "$(dirname "${1:?file}")" && pwd)/$(basename "$1")

vault=$(dirname "$file")
while [ "$vault" != / ] && [ ! -d "$vault/.obsidian" ]; do vault=$(dirname "$vault"); done
[ -d "$vault/.obsidian" ] || { echo "obs: $file is not inside an Obsidian vault" >&2; exit 1; }

q() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"; }
open "obsidian://open?vault=$(q "$(basename "$vault")")&file=$(q "${file#"$vault"/}")"
